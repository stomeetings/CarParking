# Copy to .env and fill in. .env holds the camera password: it is excluded from git and from the Docker image.
#   cp .env.example .env

# --- Camera (required for Mode 5 and scripts/collect_dataset.py) ---
# Hikvision: Channels/101 = main stream (full resolution), 102 = sub-stream. A '@' in the password is written %40.
CARPARK_RTSP_URL=rtsp://USER:PASSWORD@CAMERA_IP:554/Streaming/Channels/101

# --- Local time for the history (entry/exit times, file names) ---
CARPARK_TZ=Asia/Karachi

# --- docker compose only ---
# Host port of the Streamlit UI
CARPARK_PORT=8501
# Host folder for persistent data, mounted at /data in the container:
#   parking_history.db   slot maps, sessions, events, UI settings
#   config/              fixed_slots.json (Mode 5 fixed slot maps)
#   dataset_raw/         saved raw frames (snapshots, "save every N s")
CARPARK_DATA_DIR=./data
# Image tag built / run by docker compose
CARPARK_TAG=local

# --- Paths inside the container (set by the Dockerfile; override only for a non-standard layout) ---
# CARPARK_HISTORY_DB=/data/parking_history.db
# CARPARK_FIXED_SLOTS=/data/config/fixed_slots.json
# CARPARK_DATASET_RAW=/data/dataset_raw

# --- Mode 5 background worker ---
# embedded: the page starts scripts/worker.py itself (single container / plain `streamlit run`)
# external: a separate service runs it (docker-compose.yml sets this for the ui service)
# CARPARK_WORKER=embedded

# --- FastAPI backend + React app (docker compose service "api") ---
# Token for the write endpoints (PUT /api/settings, POST /api/commands): "Authorization: Bearer <token>".
# Empty = read-only API. Make one: python -c "import secrets; print(secrets.token_urlsafe(24))"
CARPARK_API_TOKEN=
CARPARK_API_PORT=8080

# --- go2rtc (camera video for the React app) ---
# Sub-stream URL (Hikvision: Channels/102), re-encoded to H.264 for the browser
CARPARK_RTSP_SUB_URL=rtsp://USER:PASSWORD@CAMERA_IP:554/Streaming/Channels/102
# this host's LAN address for WebRTC media (UDP/TCP 8555); go2rtc's API is never published
GO2RTC_CANDIDATE=HOST_LAN_IP:8555
# Viewer token: the React app (video, images, status, history) asks for it once. Empty = open on the LAN.
# The admin token (CARPARK_API_TOKEN) also works for viewing.
CARPARK_VIEW_TOKEN=

# --- Detector model (React app: Settings > Detector model) ---
# "Auto" picks yolo11m at worker start with a CUDA GPU, or on a CPU with at least these cores and GB of RAM;
# otherwise the light default (yolov8s). yolo11m.pt is downloaded on first use into CARPARK_MODELS_DIR
# (default: models/ next to the database, i.e. ./data/models under compose).
# CARPARK_YOLO11M_MIN_CORES=16
# CARPARK_YOLO11M_MIN_RAM_GB=16

# --- Camera registry (PostgreSQL, compose service "db") ---
# Cameras and their slot coordinates. Without CARPARK_DATABASE_URL a cameras.json next to the database is used.
# Make a password: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
CARPARK_DATABASE_URL=postgresql://carparking:POSTGRES_PASSWORD@db:5432/carparking
# Central history (Step 4): the "sync" service copies every camera's history into PostgreSQL every few seconds.
# Retention applies to PostgreSQL only (the SQLite files keep everything); 0 = keep forever.
CARPARK_SYNC_EVERY=2
CARPARK_RETENTION_DAYS=365
CARPARK_SAMPLE_RETENTION_DAYS=90

# --- AI calibrate on the Sample test page (Google Gemini vision model; the zone's picture is sent to Google: use a paid tier with a no-training policy) ---
# Empty / missing key = the button answers 501 "not set up". Get a key in Google AI Studio; never commit it.
# GEMINI_API_KEY=
# Default gemini-3.5-flash; if it is overloaded (503/504) try gemini-3.5-flash-lite. gemini-2.5-* are no longer offered to new accounts.
# GEMINI_MODEL=gemini-3.5-flash

# Phase 2 camera setup (distance / area / capacity, docs/PHASE2_GEOMETRY_PLAN.md). OFF by default: with it off the setup
# endpoints answer 503 and nothing else changes. To use it: set this to 1 in .env (the api AND the worker read it: both get
# .env), recreate them with `docker compose up -d --build`, then start the on-demand setup service for the first calibration
# (docker compose --profile setup up -d setup). Re-anchoring after a camera move does not need the setup service.
# See docs/PHASE2_DEPLOYMENT.md.
# CARPARK_GEOMETRY_ENABLED=0
# CARPARK_SETUP_URL=http://setup:8100
# Phase 2 drift guard (only with CARPARK_GEOMETRY_ENABLED): how often the worker checks that the camera has not moved, and how many
# confirmed checks in a row mark the calibration stale. Defaults: 30 s and 3.
# CARPARK_DRIFT_EVERY=30
# CARPARK_DRIFT_CONFIRM=3

